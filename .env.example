# Copy to .env. Every value is optional in development.

# development | testing | production
ANGA_ENV=development

# Generated into instance/ if left empty. Set it when running several instances.
SECRET_KEY=

# Defaults to instance/anga_air.db
DATABASE_PATH=

# Demo account passwords used by `flask --app anga seed`
ANGA_ADMIN_PASSWORD=AngaAdmin#2026
ANGA_AGENT_PASSWORD=AngaAgent#2026
ANGA_CUSTOMER_PASSWORD=AngaFly#2026

# Set to 0 only when serving production over plain http://localhost
# ANGA_COOKIE_SECURE=1

# Seconds before the simulated M-Pesa prompt resolves
MPESA_SIM_SECONDS=4

# Port for `python run.py`
# PORT=5000
